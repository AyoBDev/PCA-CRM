# Unit-test environment overrides — copy to `.env.test` (gitignored) to
# customize locally. `npm test` works without this file: jest.globalSetup.js
# auto-provisions the DB and jest.setup.js defaults the keys below, all with
# the same values shown here.
#
# DATABASE_URL must end in "_test" — jest.setup.js refuses to run against a
# non-test database (guards against accidentally wiping dev/prod data).
DATABASE_URL="postgresql://mac@localhost:5432/nvbestpca_authlifecycle_test"

# PHI-at-rest encryption key (AES-256-GCM, 64 hex chars / 32 bytes) — required
# for any write to an encrypted PHI field (Client.medicaidId/dob/notes/
# pcaNotes, Employee.dob/notes, HospitalVisit.*). Fixed dev value keeps unit
# runs deterministic; mirrors src/__integration__/setupEnv.js.
ENCRYPTION_KEY="eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"

# Timesheet signature integrity HMAC key (SHA-256, 64 hex chars / 32 bytes) —
# required for signed-timesheet submit/re-submit paths. Fixed dev value.
INTEGRITY_KEY="ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
