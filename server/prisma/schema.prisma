generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                       @id @default(autoincrement())
  email                   String                    @unique
  passwordHash            String                    @map("password_hash")
  name                    String
  role                    String                    @default("pca")
  phone                   String                    @default("") @map("phone")
  permissionGroupId       Int?                      @map("permission_group_id")
  permissionsVersion      Int                       @default(1) @map("permissions_version")
  active                  Boolean                   @default(true) @map("active")
  status                  String                    @default("active") @map("status")
  archivedAt              DateTime?                 @map("archived_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  authorization_documents authorization_documents[]
  uploadedDocuments       ClientDocument[]
  uploadedLeadDocuments   LeadDocument[]
  activities              ClientActivity[]
  employee                Employee?
  assignedTasks           Task[]            @relation("TaskAssignee")
  triggerDefaults         WorkflowTrigger[] @relation("TriggerAssignee")
  sentScheduleNotifications ScheduleNotification[] @relation("ScheduleSentBy")
  adminFiles              AdminFile[]
  messages                  Message[]
  pushSubscriptions         PushSubscription[]
  seenAttentionEvents       AdminEventSeen[]
  permissionGroup         PermissionGroup?  @relation(fields: [permissionGroupId], references: [id], onDelete: SetNull)

  @@map("users")
}

model AdminEventSeen {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  eventKey  String   @map("event_key")
  seenAt    DateTime @default(now()) @map("seen_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId])
  @@map("admin_event_seen")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @default(uuid())
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model OnboardingToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique @default(uuid())
  employeeId  Int       @unique @map("employee_id")
  status      String    @default("pending") @map("status")
  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("onboarding_tokens")
}

model EmployeeAvailability {
  id                   Int       @id @default(autoincrement())
  employeeId           Int       @unique @map("employee_id")
  availableFrom        DateTime  @map("available_from")
  availableUntil       DateTime? @map("available_until")
  weeklySchedule       Json      @map("weekly_schedule")
  maxHoursPerWeek      Int       @map("max_hours_per_week")
  maxConcurrentClients Int       @map("max_concurrent_clients")
  maxTravelDistance     Int       @map("max_travel_distance")
  transportation       String    @map("transportation")
  holidayAvailability  Json      @map("holiday_availability")
  blackoutDates        Json      @map("blackout_dates")
  initialTimeOff       Json      @map("initial_time_off")
  notes                String    @default("") @map("notes")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_availability")
}

model Employee {
  id                      Int                    @id @default(autoincrement())
  name                    String
  phone                   String                 @default("") @map("phone")
  email                   String                 @default("") @map("email")
  active                  Boolean                @default(true) @map("active")
  userId                  Int?                   @unique @map("user_id")
  archivedAt              DateTime?              @map("archived_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  dob                     String                 @default("") @map("dob")
  address                 String                 @default("") @map("address")
  clientAssignment        String                 @default("") @map("client_assignment")
  npi                     String                 @default("") @map("npi")
  idExpDate               DateTime?              @map("id_exp_date")
  firstAssignmentDate     DateTime?              @map("first_assignment_date")
  tbDueDate               DateTime?              @map("tb_due_date")
  tbType                  String                 @default("") @map("tb_type")
  cprDueDate              DateTime?              @map("cpr_due_date")
  trainingDueDate         DateTime?              @map("training_due_date")
  backgroundCheckDueDate  DateTime?              @map("background_check_due_date")
  dischargeDate           DateTime?              @map("discharge_date")
  status                  String                 @default("active") @map("status")
  notes                   String                 @default("") @map("notes")
  critical                Boolean                @default(false) @map("critical")
  complianceStatus        String                 @default("ok") @map("compliance_status")
  onboardingStatus        String                 @default("invitation_pending") @map("onboarding_status")
  availability            Json?                  @map("availability")
  latitude                Float?                 @map("latitude")
  longitude               Float?                 @map("longitude")
  geocodedAt              DateTime?              @map("geocoded_at")
  geocodeStatus           String                 @default("pending") @map("geocode_status")
  geocodeAddressHash      String                 @default("") @map("geocode_address_hash")
  careTeamAssignments     ClientCareTeam[]
  certifications          EmployeeCertification[]
  scheduleLink            EmployeeScheduleLink?
  onboardingToken         OnboardingToken?
  employeeAvailability    EmployeeAvailability?
  user                    User?                  @relation(fields: [userId], references: [id])
  notifications           ScheduleNotification[]
  shifts                  Shift[]
  payrollProfile          PayrollProfile?
  receipts                PayReceipt[]
  availabilityRequests    AvailabilityRequest[]
  timeOffRequests         TimeOffRequest[]
  conversation            Conversation?
  employeeTasks           EmployeeTask[]
  portalNotifications     Notification[]
  shiftOffers             ShiftOffer[]
  shiftCallouts           ShiftCallout[]         @relation("CalloutEmployee")
  gender                       String   @default("") @map("gender")
  preferredLanguage            String   @default("") @map("preferred_language")
  ssn                          String   @default("") @map("ssn")
  emergencyContactName         String   @default("") @map("emergency_contact_name")
  emergencyContactRelationship String   @default("") @map("emergency_contact_relationship")
  emergencyContactPhone        String   @default("") @map("emergency_contact_phone")
  emergencyContactEmail        String   @default("") @map("emergency_contact_email")
  onboardingDraft              Json?    @map("onboarding_draft")
  adminReviewNote              String   @default("") @map("admin_review_note")
  requirements                 EmployeeRequirement[]
  documents                    EmployeeDocument[]
  policyAcks                   EmployeePolicyAck[]

  @@map("employees")
}

model EmployeeCertification {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  certType     String    @map("cert_type")
  expirationDate DateTime? @map("expiration_date")
  status       String    @default("active") @map("status")
  fileName     String    @default("") @map("file_name")
  fileSize     Int       @default(0) @map("file_size")
  fileType     String    @default("") @map("file_type")
  fileData     Bytes?    @map("file_data")
  notes        String    @default("") @map("notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploads      CertificationUpload[]

  @@index([employeeId, certType])
  @@map("employee_certifications")
}

model CertificationUpload {
  id              Int                   @id @default(autoincrement())
  certificationId Int                   @map("certification_id")
  bucketKey       String                @map("bucket_key")
  fileName        String                @map("file_name")
  fileSize        Int                   @map("file_size")
  fileType        String                @map("file_type")
  note            String                @default("") @map("note")
  submittedAt     DateTime              @default(now()) @map("submitted_at")
  uploadedById    Int?                  @map("uploaded_by_id")
  uploadedByName  String                @default("") @map("uploaded_by_name")
  effectiveDate   DateTime?             @map("effective_date")
  expirationDate  DateTime?             @map("expiration_date")
  certification   EmployeeCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([certificationId])
  @@map("certification_uploads")
}

model EmployeeScheduleLink {
  id         Int      @id @default(autoincrement())
  token      String   @unique @default(uuid())
  employeeId Int      @unique @map("employee_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_schedule_links")
}

model ScheduleNotification {
  id                Int       @id @default(autoincrement())
  employeeId        Int       @map("employee_id")
  weekStart         DateTime  @map("week_start")
  method            String    @map("method")
  destination       String    @map("destination")
  status            String    @default("pending") @map("status")
  confirmationToken String    @unique @default(uuid()) @map("confirmation_token")
  confirmedAt       DateTime? @map("confirmed_at")
  sentAt            DateTime? @map("sent_at")
  failureReason     String    @default("") @map("failure_reason")
  response          String    @default("") @map("response")
  responseNotes     String    @default("") @map("response_notes")
  respondedAt       DateTime? @map("responded_at")
  openedAt          DateTime? @map("opened_at")
  message           String    @default("") @map("message")
  sentById          Int?      @map("sent_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sentByUser        User?     @relation("ScheduleSentBy", fields: [sentById], references: [id])

  @@index([employeeId])
  @@index([weekStart])
  @@map("schedule_notifications")
}

model Client {
  id                         Int              @id @default(autoincrement())
  clientName                 String           @map("client_name")
  medicaidId                 String           @default("") @map("medicaid_id")
  insuranceType              String           @default("MEDICAID") @map("insurance_type")
  address                    String           @default("") @map("address")
  phone                      String           @default("") @map("phone")
  gateCode                   String           @default("") @map("gate_code")
  notes                      String           @default("") @map("notes")
  enabledServices            String           @default("[\"PAS\",\"Homemaker\"]") @map("enabled_services")
  archivedAt                 DateTime?        @map("archived_at")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")
  backupDoctorName           String           @default("") @map("backup_doctor_name")
  backupDoctorPhone          String           @default("") @map("backup_doctor_phone")
  critical                   Boolean          @default(false) @map("critical")
  dob                        String           @default("") @map("dob")
  doctorName                 String           @default("") @map("doctor_name")
  doctorPhone                String           @default("") @map("doctor_phone")
  paNumber                   String           @default("") @map("pa_number")
  caregiverRequirements      String           @default("") @map("caregiver_requirements")
  email                      String           @default("") @map("email")
  emergencyContactName       String           @default("") @map("emergency_contact_name")
  emergencyContactPhone      String           @default("") @map("emergency_contact_phone")
  emergencyContactRelation   String           @default("") @map("emergency_contact_relation")
  gender                     String           @default("") @map("gender")
  mainServices               String           @default("") @map("main_services")
  carePlanSchedule           String           @default("") @map("care_plan_schedule")
  pcaNotes                   String           @default("") @map("pca_notes")
  secondaryAddress           String           @default("") @map("secondary_address")
  secondaryEmergencyName     String           @default("") @map("secondary_emergency_name")
  secondaryEmergencyPhone    String           @default("") @map("secondary_emergency_phone")
  secondaryEmergencyRelation String           @default("") @map("secondary_emergency_relation")
  secondaryPhone             String           @default("") @map("secondary_phone")
  client_status              String           @default("active")
  authorizationRequired      Boolean          @default(true) @map("authorization_required")
  overrideActive             Boolean          @default(false) @map("override_active")
  overrideExpiresOn          DateTime?        @map("override_expires_on")
  overrideReason             String           @default("") @map("override_reason")
  overrideBy                 String           @default("") @map("override_by")
  latitude                   Float?           @map("latitude")
  longitude                  Float?           @map("longitude")
  geocodedAt                 DateTime?        @map("geocoded_at")
  geocodeStatus              String           @default("pending") @map("geocode_status")
  geocodeAddressHash         String           @default("") @map("geocode_address_hash")
  authorizations             Authorization[]
  careTeam                   ClientCareTeam[]
  documents                  ClientDocument[]
  clientNotes                ClientNote[]
  hospitalVisits             HospitalVisit[]
  incidents                  Incident[]
  activities                 ClientActivity[]
  permanentLinks             PermanentLink[]
  shifts                     Shift[]
  timesheets                 Timesheet[]

  @@map("clients")
}

model ClientNote {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  date      DateTime
  type      String   @default("")
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_notes")
}

model ClientCareTeam {
  id         Int      @id @default(autoincrement())
  clientId   Int      @map("client_id")
  employeeId Int      @map("employee_id")
  role       String   @default("agency_pca") @map("role")
  assignedAt DateTime @default(now()) @map("assigned_at")
  notes      String   @default("") @map("notes")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([employeeId])
  @@map("client_care_team")
}

model ClientDocument {
  id         Int      @id @default(autoincrement())
  clientId   Int      @map("client_id")
  category   String   @map("category")
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  fileSize   Int      @map("file_size")
  mimeType   String   @default("") @map("mime_type")
  fileData   Bytes?   @map("file_data")
  uploadedBy Int?     @map("uploaded_by")
  notes      String   @default("") @map("notes")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploader   User?    @relation(fields: [uploadedBy], references: [id])

  @@index([clientId])
  @@map("client_documents")
}

model HospitalVisit {
  id           Int      @id @default(autoincrement())
  clientId     Int      @map("client_id")
  visitDate    DateTime @map("visit_date")
  visitTime    String   @default("") @map("visit_time")
  providerName String   @default("") @map("provider_name")
  location     String   @default("") @map("location")
  purpose      String   @default("") @map("purpose")
  status       String   @default("upcoming") @map("status")
  notes        String   @default("") @map("notes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("hospital_visits")
}

model Incident {
  id           Int       @id @default(autoincrement())
  clientId     Int       @map("client_id")
  incidentDate DateTime  @map("incident_date")
  description  String    @default("") @map("description")
  severity     String    @default("minor") @map("severity")
  reportedBy   String    @default("") @map("reported_by")
  status       String    @default("open") @map("status")
  resolvedAt   DateTime? @map("resolved_at")
  resolution   String    @default("") @map("resolution")
  notes        String    @default("") @map("notes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("incidents")
}

model ClientActivity {
  id          Int      @id @default(autoincrement())
  clientId    Int      @map("client_id")
  userId      Int      @map("user_id")
  type        String   @map("type")
  subject     String   @default("")
  description String   @default("")
  contactName String   @default("") @map("contact_name")
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@map("client_activities")
}

model Authorization {
  id                      Int                       @id @default(autoincrement())
  clientId                Int                       @map("client_id")
  serviceCategory         String                    @default("") @map("service_category")
  serviceCode             String                    @map("service_code")
  serviceName             String                    @default("") @map("service_name")
  authorizedUnits         Int                       @default(0) @map("authorized_units")
  authorizationStartDate  DateTime?                 @map("authorization_start_date")
  authorizationEndDate    DateTime?                 @map("authorization_end_date")
  notes                   String                    @default("") @map("notes")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  archivedAt              DateTime?                 @map("archived_at")
  authorizationNumber     String                    @default("") @map("authorization_number")
  authorizedHours         Float                     @default(0) @map("authorized_hours")
  accountNumber           String                    @default("") @map("account_number")
  sandataClientId         String                    @default("") @map("sandata_client_id")
  manualStatus            String                    @default("active") @map("manual_status")
  authorizationType       String                    @default("Weekly Units") @map("authorization_type")
  authorizedVisitsPerYear Int?                      @map("authorized_visits_per_year")
  hoursPerVisit           Float?                    @map("hours_per_visit")
  authorizedHoursPerYear  Float?                    @map("authorized_hours_per_year")
  usedHoursYtd            Float                     @default(0) @map("used_hours_ytd")
  renewedFromId           Int?                      @map("renewed_from_id")
  renewedToId             Int?                      @map("renewed_to_id")
  inactiveReason          String                    @default("") @map("inactive_reason")
  inactiveNote            String                    @default("") @map("inactive_note")
  closedAt                DateTime?                 @map("closed_at")
  authorization_documents authorization_documents[]
  client                  Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("authorizations")
}

model Lead {
  id                       Int       @id @default(autoincrement())

  // Step 1 — Basic info
  firstName                String    @default("") @map("first_name")
  lastName                 String    @default("") @map("last_name")
  phone                    String    @default("")
  alternatePhone           String    @default("") @map("alternate_phone")
  address                  String    @default("")
  dob                      DateTime? @map("dob")
  gender                   String    @default("")
  medicaidId               String    @default("") @map("medicaid_id")
  insuranceNumber          String    @default("") @map("insurance_number")
  insuranceType            String    @default("") @map("insurance_type")
  referralSource           String    @default("") @map("referral_source")
  // Channel the lead came in through: referrer | call | website | fax | other
  leadSource               String    @default("") @map("lead_source")
  doctorName               String    @default("") @map("doctor_name")
  doctorPhone              String    @default("") @map("doctor_phone")
  caseworkerName           String    @default("") @map("caseworker_name")
  caseworkerPhone          String    @default("") @map("caseworker_phone")
  emergencyContactName     String    @default("") @map("emergency_contact_name")
  emergencyContactRelation String    @default("") @map("emergency_contact_relation")
  emergencyContactPhone    String    @default("") @map("emergency_contact_phone")
  emergencyContactEmail    String    @default("") @map("emergency_contact_email")
  callNotes                String    @default("") @map("call_notes")

  // Step 2 — Service needs
  servicesRequested        String    @default("[]") @map("services_requested")
  daysPerWeek              String    @default("") @map("days_per_week")
  hoursPerDay              String    @default("") @map("hours_per_day")
  startDateNeeded          String    @default("") @map("start_date_needed")

  // Step 3 — Case type + conditional
  caseType                 String    @default("initial") @map("case_type")
  authStatus               String    @default("") @map("auth_status")
  expectedStartDate        DateTime? @map("expected_start_date")
  currentAgencyName        String    @default("") @map("current_agency_name")
  currentAuthHoursMonth    Int       @default(0) @map("current_auth_hours_month")
  authNumber               String    @default("") @map("auth_number")
  transferReason           String    @default("") @map("transfer_reason")
  transferNotes            String    @default("") @map("transfer_notes")
  ppRate                   Float     @default(0) @map("pp_rate")
  ppHoursPerWeek           Float     @default(0) @map("pp_hours_per_week")
  ppDepositHours           Float     @default(0) @map("pp_deposit_hours")

  // Step 4 — Preferences
  genderPreference         String    @default("No preference") @map("gender_preference")
  agePreference            String    @default("No preference") @map("age_preference")
  shiftPreferences         String    @default("[]") @map("shift_preferences")
  languagePreference       String    @default("English") @map("language_preference")
  scheduleNotes            String    @default("") @map("schedule_notes")

  // Step 5 — Status routing
  status                   String    @default("new")
  assignedTo               String    @default("") @map("assigned_to")
  followUpDate             DateTime? @map("follow_up_date")

  // Staff attribution
  createdBy                String    @default("") @map("created_by")

  // Conversion linkage
  convertedClientId        Int?      @map("converted_client_id")
  convertedAt              DateTime? @map("converted_at")
  // Pipeline stage the lead was in right before conversion, so a reverted
  // conversion can restore it to where it was (empty = pre-feature / unknown).
  preConvertStatus         String    @default("") @map("pre_convert_status")

  archivedAt               DateTime? @map("archived_at")
  dormantAt                DateTime? @map("dormant_at")
  // When the lead last entered its current pipeline stage (status). Used by the
  // "stuck in a stage" reminder so unrelated edits (e.g. logging a contact,
  // which bumps updatedAt) don't reset the stuck timer. Null = pre-feature rows.
  stageEnteredAt           DateTime? @map("stage_entered_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  contacts                 LeadContact[]

  documents                LeadDocument[]

  @@index([status])
  @@index([dormantAt])
  @@map("leads")
}

model LeadContact {
  id           Int       @id @default(autoincrement())
  leadId       Int       @map("lead_id")
  outcome      String    @default("")
  method       String    @default("call")
  note         String    @default("")
  followUpDate DateTime? @map("follow_up_date")
  createdBy    String    @default("") @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_contacts")
}

// Files/images attached to a lead at intake (referral scans, forms, photos).
// Mirrors ClientDocument: bytes live in the object bucket (key = filePath).
model LeadDocument {
  id         Int      @id @default(autoincrement())
  leadId     Int      @map("lead_id")
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  fileSize   Int      @map("file_size")
  mimeType   String   @default("") @map("mime_type")
  uploadedBy Int?     @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploader   User?    @relation(fields: [uploadedBy], references: [id])

  @@index([leadId])
  @@map("lead_documents")
}

model InsuranceType {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  color      String    @default("#9E9E9E")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("insurance_types")
}

model Service {
  id               Int       @id @default(autoincrement())
  category         String
  code             String    @unique
  name             String    @default("")
  label            String    @default("")
  accountNumber    String    @default("") @map("account_number")
  color            String    @default("")
  timesheetSection String    @default("") @map("timesheet_section")
  sortOrder        Int       @default(50) @map("sort_order")
