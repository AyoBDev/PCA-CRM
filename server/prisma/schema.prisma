/// A caregiver calling out of a scheduled shift. Opens the replacement workflow.
model ShiftCallout {
  id                Int       @id @default(autoincrement())
  shiftId           Int       @map("shift_id")
  calloutEmployeeId Int?      @map("callout_employee_id")
  reason            String    @default("")
  reportedById      Int?      @map("reported_by_id")
  /// 'open' | 'filled' | 'no_coverage' | 'cancelled'
  resolution        String    @default("open")
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  shift             Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  calloutEmployee   Employee? @relation("CalloutEmployee", fields: [calloutEmployeeId], references: [id], onDelete: SetNull)
  offers            ShiftOffer[]

  @@index([shiftId])
  @@index([resolution])
  @@map("shift_callouts")
}

/// One replacement offer to one candidate. This table is the compliance record:
/// it answers "who was offered this shift, in what order, and when" for audit.
///
/// offeredAt is null while an offer is only a ranked suggestion (shadow mode) —
/// that distinguishes "who we would have asked" from "who we actually asked".
model ShiftOffer {
  id             Int           @id @default(autoincrement())
  shiftId        Int           @map("shift_id")
  calloutId      Int?          @map("callout_id")
  employeeId     Int           @map("employee_id")
  /// Position in the ranked candidate list at the time of ranking.
  rank           Int           @default(0)
  /// Per-term score contributions, so a past ranking stays explainable.
  scoreBreakdown Json          @default("{}") @map("score_breakdown")
  /// 'portal' | 'email' | 'sms'
  channel        String        @default("")
  token          String        @unique @default(uuid())
  offeredAt      DateTime?     @map("offered_at")
  expiresAt      DateTime?     @map("expires_at")
  respondedAt    DateTime?     @map("responded_at")
  /// '' (pending) | 'accepted' | 'declined' | 'expired' | 'skipped'
  response       String        @default("")
  failureReason  String        @default("") @map("failure_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  shift          Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  callout        ShiftCallout? @relation(fields: [calloutId], references: [id], onDelete: SetNull)
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([employeeId])
  @@index([calloutId])
  @@map("shift_offers")
}

