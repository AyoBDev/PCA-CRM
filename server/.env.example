DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nvbestpca"
PORT=4000
JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@nvbestpca.com"
ADMIN_PASSWORD="change-me-in-production"
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME=""
# PHI encryption at rest (SSN/EIN, Medicaid IDs, DOBs, notes, hospital visits).
# 64 hex chars (32 bytes): generate with `openssl rand -hex 32`.
# LOSING THIS KEY MAKES ENCRYPTED PHI UNRECOVERABLE — including in backups.
ENCRYPTION_KEY=""
# Timesheet signature-integrity HMAC key (64 hex chars). Falls back to a key
# derived from ENCRYPTION_KEY when unset. Changing it flags all previously
# signed timesheets as tampered.
INTEGRITY_KEY=""
# Local-dev-only escape hatch: allow the server to boot WITHOUT ENCRYPTION_KEY
# and store PHI in plaintext. Never set this in test/staging/production.
ALLOW_PLAINTEXT_PHI=""

# ── Error tracking (Sentry) — optional ──
# Set SENTRY_DSN to enable server-side error tracking. When unset, error
# tracking is a complete no-op (nothing is captured or sent). Get the DSN from
# your Sentry project (free tier or self-hosted).
SENTRY_DSN=""
# Optional Sentry tuning:
#   SENTRY_ENVIRONMENT     — label for the environment (defaults to NODE_ENV)
#   SENTRY_RELEASE         — release/version tag for grouping deploys
#   SENTRY_TRACES_SAMPLE_RATE — performance tracing sample rate 0..1 (default 0 = off)
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=""
